<?php
require_once 'ConexaoBD.php';

$con = new ConexaoBD();
$conn = $con->conectar();

if ($conn) {
    echo "Conexão bem-sucedida!<br>";

    $sql = "SELECT * FROM administrador";
    $result = $conn->query($sql);

    while($row = $result->fetch_assoc()) {
        echo "ID: " . $row["idadministrador"] . 
             " - Nome: " . $row["nome"] . 
             " - CPF: " . $row["cpf"] . "<br>";
    }

    $conn->close();
} else {
    echo "Falha na conexão!";
}
?>
